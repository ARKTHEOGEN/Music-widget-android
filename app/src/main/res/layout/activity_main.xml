<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/setup_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            style="@style/SetupHeading"
            android:text="@string/step_access_title" />
        <TextView
            style="@style/SetupBody"
            android:text="@string/step_access_body" />
        <TextView
            android:id="@+id/access_status"
            style="@style/SetupBody"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btn_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grant_access" />
        <TextView
            style="@style/SetupBody"
            android:text="@string/restricted_note" />
        <Button
            android:id="@+id/btn_app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_app_info" />

        <LinearLayout
            android:id="@+id/xiaomi_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                style="@style/SetupHeading"
                android:text="@string/step_xiaomi_title" />
            <TextView
                style="@style/SetupBody"
                android:text="@string/step_xiaomi_body" />
        </LinearLayout>

        <TextView
            style="@style/SetupHeading"
            android:text="@string/step_apps_title" />
        <TextView
            android:id="@+id/apps_status"
            style="@style/SetupBody" />

        <TextView
            style="@style/SetupHeading"
            android:text="@string/step_widget_title" />
        <TextView
            style="@style/SetupBody"
            android:text="@string/step_widget_body" />
        <Button
            android:id="@+id/btn_add_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_widget" />
        <Button
            android:id="@+id/btn_open_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_player" />
        <Button
            android:id="@+id/btn_side_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_side_setup" />
        <Button
            android:id="@+id/btn_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_diagnostics" />

        <TextView
            style="@style/SetupHeading"
            android:text="@string/tips_title" />
        <TextView
            style="@style/SetupBody"
            android:text="@string/tips_body" />
    </LinearLayout>
</ScrollView>
